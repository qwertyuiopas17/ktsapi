# ---- Core ----
APP_ENV=development            # development | test | staging | production
APP_DEBUG=false
DATABASE_URL=postgresql://kts:kts@localhost:5432/kts
DB_ECHO=false
CORS_ORIGINS=["http://localhost:3000","http://localhost:8081"]

# ---- Auth ----
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_EXPIRY_MINUTES=60
REFRESH_TOKEN_EXPIRY_DAYS=30
PIN_MAX_ATTEMPTS=5
FIREBASE_CREDENTIALS_PATH=./firebase-credentials.json
FIREBASE_PROJECT_ID=your-firebase-project-id
# Accept "dev:+91XXXXXXXXXX" instead of a Firebase ID token (local development only)
AUTH_DEV_STUB=true

# ---- Rate limiting ----
RATE_LIMIT_ENABLED=true
RATE_LIMIT_STORAGE_URI=memory://     # use redis://redis:6379/0 with several workers
RATE_LIMIT_DEFAULT=300/minute
RATE_LIMIT_AUTH=20/minute

# ---- Observability ----
SENTRY_DSN=
LOG_JSON=true
LOG_LEVEL=INFO

# ---- OCR (Groq vision; GROQ_API_KEY_1..N are rotated) ----
GROQ_API_KEY=your-groq-api-key

# ---- File storage ----
AWS_ACCESS_KEY_ID=your-access-key
AWS_SECRET_ACCESS_KEY=your-secret-key
AWS_S3_BUCKET=kts-bill-images
AWS_S3_REGION=ap-south-1

# ---- Google Document AI (optional OCR fallback) ----
GOOGLE_APPLICATION_CREDENTIALS=./google-credentials.json
GOOGLE_PROJECT_ID=your-project-id
GOOGLE_LOCATION=us
GOOGLE_PROCESSOR_ID=your-processor-id
